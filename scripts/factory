#!/usr/bin/env python3
"""factory: operate the local software factory.

  factory new <owner/repo> <title> "<claim> | <check>" ["<claim> | <check>" ...] [-d <description>]
  factory add-repo <owner/repo>           check a repo and enable it (it needs pr-gatekeeper)
  factory bench <owner/repo> [-w <worker>] ...  file the benchmark's tasks in a sandbox repo
  factory bench report [<run>]            grade a run: person needed, passes, lines, time, hidden tests
  factory status [<owner/repo#n>]
  factory watch                           print each WorkItem that newly waits on you (Hermes cron)
  factory drive-queue                     the escalations Day Desk may still answer (its job's monitor)
  factory report                          the last 7 days in one message: autonomy, escalations, lessons
  factory retry  <owner/repo#n> <note>    try again; the note goes to the worker as a finding
  factory regate <owner/repo#n> <note>    the gate reviews again: your pushed fix, or the same head
  factory close  <owner/repo#n> <note>    give up on this WorkItem
  factory stop                            kill switch: cancel running workers, stop factory-mcp
  factory start                           start Docker, the relay and factory-mcp
  factory logs                            follow the factory-mcp log
  factory update                          deploy this checkout's branch if its tests pass
  factory call <tool> [<json arguments>]  one raw factory-mcp tool call
  factory serve                           run factory-mcp in the foreground (the launchd entry)

Settings: ~/.config/factory-mcp/env. Secrets: ~/.config/factory-mcp/secrets (FACTORY_MCP_TOKEN).
FACTORY_GITHUB_TOKEN comes from `gh auth token` unless the secrets file sets it.
"""
import calendar
import http.client
import io
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.request
import zipfile
from pathlib import Path

CONFIG = Path.home() / ".config" / "factory-mcp"
STATE = Path.home() / ".local" / "state" / "factory-mcp"
LABEL = "com.software-factory.factory-mcp"
RELAY_LABEL = "com.agent-relay"
HERE = Path(os.path.realpath(__file__)).parent.parent


def die(message):
    sys.exit(f"factory: {message}")


def read_env(path):
    """KEY=VALUE lines, as `set -a; . file` would read them, for the simple values used here."""
    values = {}
    if path.is_file():
        for line in path.read_text().splitlines():
            if "=" in line and not line.lstrip().startswith("#"):
                key, value = line.split("=", 1)
                value = value.strip()
                if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
                    value = value[1:-1]
                values[key.strip()] = value
    return values


SETTINGS = read_env(CONFIG / "env")
PORT = int(SETTINGS.get("FACTORY_PORT") or 43125)
RELAY = (SETTINGS.get("FACTORY_RELAY_URL") or "http://127.0.0.1:43124").rstrip("/")


def run(*cmd, check=False):
    return subprocess.run(cmd, capture_output=True, text=True, check=check)


def call(tool, arguments=None, timeout=60):
    """One tools/call to factory-mcp on this machine. The token is read here and never printed."""
    token = read_env(CONFIG / "secrets").get("FACTORY_MCP_TOKEN")
    if not token:
        die(f"no FACTORY_MCP_TOKEN in {CONFIG / 'secrets'}")
    body = {"jsonrpc": "2.0", "id": 1, "method": "tools/call",
            "params": {"name": tool, "arguments": arguments or {}}}
    connection = http.client.HTTPConnection("127.0.0.1", PORT, timeout=timeout)
    try:
        connection.request("POST", "/mcp", json.dumps(body),
                           {"Authorization": f"Bearer {token}", "Content-Type": "application/json"})
    except ConnectionRefusedError:
        die(f"factory-mcp is not running on port {PORT} (start it with: factory start)")
    reply = json.loads(connection.getresponse().read())
    if "error" in reply:
        die(json.dumps(reply["error"]))
    value = json.loads(reply["result"]["content"][0]["text"])
    if reply["result"].get("isError"):
        die(value.get("error", value))
    return value


AGENT_GRACE_SECONDS = 1800  # how long Day Desk may take on an escalation before the owner hears of it


def waits_on_owner(wi, driving, now):
    """Whether the owner must hear of `wi`. Exhausted always waits on the owner (ADR-0035).
    Otherwise: when Day Desk drives (ADR-0030), it answers first, and the owner hears of one it
    may not answer, or one it has left for AGENT_GRACE_SECONDS."""
    if wi["state"] == "exhausted":
        return True
    if wi["state"] not in ("human_waiting", "blocked"):
        return False
    if not driving or not wi.get("agentMayResolve"):
        return True
    return now - calendar.timegm(time.strptime(wi["updatedAt"], "%Y-%m-%dT%H:%M:%SZ")) >= AGENT_GRACE_SECONDS


def cmd_watch(_):
    """For a Hermes no-agent cron job (ADR-0013): print each WorkItem that newly waits on the owner,
    once. Printing nothing sends nothing. When factory-mcp does not answer, the exit is non-zero,
    which Hermes delivers as an error alert."""
    seen_file = STATE / "watch.json"
    try:
        seen = json.loads(seen_file.read_text())
    except (OSError, ValueError):
        seen = {}
    driving = bool(read_env(CONFIG / "secrets").get("FACTORY_AGENT_TOKEN"))
    waiting = {wi["id"]: [wi["state"], wi.get("blockedOn")] for wi in call("factory_status")["workItems"]
               if waits_on_owner(wi, driving, time.time())}
    for workitem_id, (state, reason) in sorted(waiting.items()):
        if seen.get(workitem_id) != [state, reason]:
            print(f"{workitem_id} is {state}: {reason}\n"
                  "Reply to this message with retry, regate or close, and a note.")
    STATE.mkdir(parents=True, exist_ok=True)
    seen_file.write_text(json.dumps(waiting))


def cmd_drive_queue(_):
    """For the monitor_script of Day Desk's driving job (ADR-0030): the escalations Day Desk may
    still answer, one per line. Hermes runs the agent only when this output changes."""
    for wi in call("factory_status")["workItems"]:
        if wi.get("agentMayResolve"):
            print(f"{wi['id']} is {wi['state']}: {wi.get('blockedOn')}")


REPORT_WIDTH = 110  # characters per line; 20 such lines fit one Telegram message (4096)
LISTED = 5  # lesson candidates or lessons named one per line; the count gives the rest


def clip(line):
    return line if len(line) <= REPORT_WIDTH else line[:REPORT_WIDTH - 3] + "..."


def flat(text):
    return " ".join(str(text).split())


def share(autonomy):
    if autonomy["ended"]:
        text = (f"{autonomy['autonomous']} of {autonomy['ended']} ended WorkItems needed no person "
                f"({autonomy['rate']:.0%})")
    else:
        text = "nothing ended"
    if autonomy["unknown"]:
        text += f", and {autonomy['unknown']} rebuilt from GitHub (unknown)"
    return text


def report_lines(report):
    """factory_report as at most 19 lines, or one line when nothing ended and nothing escalated."""
    week = f"{report['since'][:10]} to {report['until'][:10]}"
    this = report["autonomy"]
    if not this["ended"] and not this["unknown"] and not report["escalated"]:
        lines = [f"Factory week {week}: nothing ended and nothing escalated."]
    else:
        lines = [f"Factory week {week}",
                 f"Autonomy: {share(this)}. The week before: {share(report['autonomyWeekBefore'])}.",
                 f"Went to a person: {report['escalated']}"
                 + (". Top reasons:" if report["topReasons"] else "")]
        lines += [f"  {group['count']}x {flat(group['reason'])}" for group in report["topReasons"]]
    if report["newCandidates"]:
        lines.append(f"New lesson candidates: {len(report['newCandidates'])}")
        lines += [f"  [{c['repo']}] {flat(c['problem'])} (on {c['workItems']} WorkItems)"
                  for c in report["newCandidates"][:LISTED]]
    if report["notWorking"]:
        lines.append(f"Lessons not working: {len(report['notWorking'])}")
        lines += [f"  [{e['repo']}] {flat(e['text'])} (recurred on {e['recurred']} of {e['sent']})"
                  for e in report["notWorking"][:LISTED]]
    return [clip(line) for line in lines]


def cmd_report(_):
    """For a Hermes no-agent cron job, Mondays at 09:00 (ADR-0025): the week in one message. It
    always prints, so Hermes always sends it; when factory-mcp does not answer, the exit is
    non-zero, which Hermes delivers as an error alert. It changes nothing."""
    print("\n".join(report_lines(call("factory_report"))))


def cmd_new(args):
    if len(args) < 3:
        die('usage: factory new <owner/repo> <title> "<claim> | <check>" ... [-d <description>] [-w <worker>]')
    repo, title, rest = args[0], args[1], args[2:]
    description, bullets, workers = title, [], []
    while rest:
        item = rest.pop(0)
        if item == "-d":
            description = rest.pop(0) if rest else description
        elif item == "-w":  # a relay agent in FACTORY_WORKERS; repeat for a failover order
            if not rest:
                die("-w needs a worker: a relay agent id from FACTORY_WORKERS")
            workers.append(rest.pop(0))
        elif " | " in item:
            claim, check = item.split(" | ", 1)
            bullets.append(f"- {claim.strip()} — done when: {check.strip()}")
        else:
            die(f'an acceptance item needs "<claim> | <check>": {item}')
    if not bullets:
        die("give at least one acceptance item")
    chosen = "".join(f"Worker: {worker}\n" for worker in workers)
    body = f"{description}\n\n" + (f"{chosen}\n" if chosen else "") + "## Acceptance\n" + "\n".join(bullets) + "\n"
    done = subprocess.run(["gh", "issue", "create", "-R", repo, "--title", title,
                           "--label", "factory:ready", "--body-file", "-"], input=body, text=True)
    sys.exit(done.returncode)


BENCH = HERE / "bench"  # the benchmark's tasks, one folder each: issue.md, test_hidden.py, reference.py
BENCH_SECONDS = 300  # how long a task's hidden tests may run


def cmd_bench(args):
    """Start a benchmark run (ADR-0037): one factory:ready issue per task in bench/, each building a
    new module under bench/<run>/ in a repo the factory may change. `report` grades a run."""
    if args[:1] == ["report"]:
        return bench_report(args[1:])
    if not args or args[0].count("/") != 1 or len(args) % 2 == 0 or set(args[1::2]) - {"-w"}:
        die("usage: factory bench <owner/repo> [-w <worker>] ... | factory bench report [<run>]")
    repo, workers, started = args[0], args[2::2], time.gmtime()
    run = time.strftime("r%m%d%H%M", started)
    record = {"run": run, "repo": repo, "workers": workers,
              "started": time.strftime("%Y-%m-%dT%H:%M:%SZ", started), "issues": {}}
    path = STATE / "bench" / f"{run}.json"
    path.parent.mkdir(parents=True, exist_ok=True)
    chosen = "".join(f"Worker: {worker}\n" for worker in workers)
    for task in sorted(issue.parent.name for issue in BENCH.glob("*/issue.md")):
        text = (BENCH / task / "issue.md").read_text().replace("{dir}", f"bench/{run}").replace("{run}", run)
        title, body = text.split("\n", 1)
        body = body.strip()
        if chosen:
            body = body.replace("\n## Acceptance", f"\n{chosen}\n## Acceptance", 1)
        done = subprocess.run(["gh", "issue", "create", "-R", repo, "--title", f"{title.lstrip('# ')} ({run})",
                               "--label", "factory:ready", "--body-file", "-"],
                              input=body + "\n", text=True, capture_output=True)
        if done.returncode:
            die(f"gh issue create failed for the {task} task: {done.stderr.strip()}")
        record["issues"][task] = int(done.stdout.strip().rsplit("/", 1)[1])
        path.write_text(json.dumps(record, indent=1))  # each issue is on record before the next is made
    print(f"{run}: {len(record['issues'])} issues in {repo}. When they end: factory bench report {run}")


def utc_seconds(stamp):
    return calendar.timegm(time.strptime(stamp, "%Y-%m-%dT%H:%M:%SZ"))


def gh_api(path):
    """One GitHub API GET through the owner's gh, as bytes: a zipball is not text."""
    done = subprocess.run(["gh", "api", path], capture_output=True)
    if done.returncode:
        die(f"gh api {path} failed: {done.stderr.decode(errors='replace').strip()}")
    return done.stdout


def hidden_tests_pass(run, task, sha):
    """Whether the task's hidden tests pass on the merged commit. They run like a worker's verify:
    in the worker image, with no network and no credential."""
    archive = gh_api(f"repos/{run['repo']}/zipball/{sha}")
    with tempfile.TemporaryDirectory() as tmp:
        zipfile.ZipFile(io.BytesIO(archive)).extractall(tmp)  # zipfile drops absolute and ".." parts of names
        tree = next(Path(tmp).iterdir())
        (tree / "tests").mkdir(exist_ok=True)
        shutil.copy(BENCH / task / "test_hidden.py", tree / "tests" / "test_bench_hidden.py")
        done = subprocess.run(["docker", "run", "--rm", "--network", "none", "-v", f"{tree}:/work", "-w", "/work",
                               "-e", f"BENCH_MODULE=bench.{run['run']}.{task}", "factory-worker:latest",
                               "timeout", str(BENCH_SECONDS), "python3", "-m", "unittest", "discover",
                               "-s", "tests", "-p", "test_bench_hidden.py"], capture_output=True, text=True)
    return done.returncode == 0


def bench_report(args):
    """Grade a run: per task, the end state, whether a person was needed, the worker passes, the
    PR's changed lines, the minutes from the run's start to the merge, and the hidden tests."""
    runs = sorted((STATE / "bench").glob("r*.json"))
    path = STATE / "bench" / f"{args[0]}.json" if args else (runs[-1] if runs else None)
    if path is None or not path.is_file():
        die("no such benchmark run; start one with: factory bench <owner/repo>")
    run = json.loads(path.read_text())
    sys.path.insert(0, str(HERE))
    from factory_mcp.metrics import REACHED_END, autonomy  # the factory's own rule for "no person"
    known = {wi["id"] for wi in call("factory_status")["workItems"]}
    rows = []
    for task, number in sorted(run["issues"].items()):
        workitem_id = f"{run['repo']}#{number}"
        if workitem_id not in known:
            rows.append([task, "not started", "", "", "", "", ""])
            continue
        status = call("factory_status", {"id": workitem_id})
        wi, person, lines, minutes, hidden = status["workItem"], "", "", "", ""
        if wi["state"] in REACHED_END:
            person = "no" if autonomy([wi], lambda _: status["history"])["autonomous"] else "yes"
        if wi.get("prNumber"):
            pr = json.loads(gh_api(f"repos/{run['repo']}/pulls/{wi['prNumber']}"))
            lines = pr["additions"] + pr["deletions"]
            if pr.get("merged_at"):
                minutes = round((utc_seconds(pr["merged_at"]) - utc_seconds(run["started"])) / 60)
                hidden = "pass" if hidden_tests_pass(run, task, pr["merge_commit_sha"]) else "fail"
        rows.append([task, wi["state"], person, status["passes"], lines, minutes, hidden])
    header = ["task", "state", "person", "passes", "lines", "minutes", "hidden tests"]
    widths = [max(len(str(row[i])) for row in [header, *rows]) for i in range(len(header))]
    print(f"{run['run']} in {run['repo']}, started {run['started']}, "
          f"workers: {', '.join(run['workers']) or 'the factory default'}")
    for row in [header, *rows]:
        print("  ".join(str(cell).ljust(width) for cell, width in zip(row, widths)).rstrip())
    merged = sorted(row[5] for row in rows if row[5] != "")
    print(f"merged with no person: {sum(row[2] == 'no' for row in rows)}/{len(rows)}; "
          f"hidden tests pass: {sum(row[6] == 'pass' for row in rows)}/{len(rows)}; "
          f"worker passes: {sum(row[3] or 0 for row in rows)}; "
          f"median minutes to merge: {merged[len(merged) // 2] if merged else '-'}")


def cmd_add_repo(args):
    """Check a repo and enable it, through the tools Day Desk uses, so the checks exist once."""
    if len(args) != 1 or args[0].count("/") != 1:
        die("usage: factory add-repo <owner/repo>")
    repo = args[0]
    checked = call("factory_repo_check", {"repo": repo})
    for check in checked["checks"]:
        print(f"{'ok  ' if check['ok'] else 'FAIL'} {check['id']}: {check['detail']}"
              + ("" if check["ok"] else f"\n     fix: {check['fix']}"))
    if not checked["ready"]:
        die(f"{repo} is not ready; fix the checks above and run this again")
    added = call("factory_add_repo", {"repo": repo, "by": SETTINGS.get("FACTORY_OWNER") or os.environ.get("USER", "")},
                 timeout=960)  # the worker checkout is cloned first
    print(f"{repo} is {'enabled' if added['added'] else 'already enabled'}. Label an issue factory:ready, "
          f"or run: factory new {repo} ...")


def cmd_status(args):
    if args:
        d = call("factory_status", {"id": args[0]})
        wi = d["workItem"]
        print(f"{wi['id']}  {wi['state']}  PR #{wi.get('prNumber') or '-'}  gate round {wi.get('gateRound', 0)}")
        if d.get("escalation"):
            print(f"  needs you: {d['escalation']['reason']}")
            print(f'  answer with: factory retry|regate|close {wi["id"]} "<note>"')
        print(f"  worker passes: {d['passes']}")
        for h in [h for h in d["history"] if not h["action"].startswith("tool:")][-8:]:
            print(f"  {h['at']}  {h['action']}  {json.dumps(h['detail'])[:110]}")
        return
    d = call("factory_status")
    for wi in d["workItems"]:
        line = f"{wi['id']:<34} {wi['state']:<18} PR #{wi.get('prNumber') or '-'}"
        print(line + (f"   needs you: {wi['blockedOn']}" if wi.get("blockedOn") else "")
              + (f"   waiting on #{wi['waitingOn']}" if wi.get("waitingOn") else ""))
    if not d["workItems"]:
        print("no WorkItems yet: label an issue factory:ready, or run: factory new")
    a = d["autonomy"]
    print(f"autonomy: {a['autonomous']} of {a['ended']} finished WorkItems needed no person")
    if d.get("lessonsError"):
        print(f"lessons: {d['lessonsError']}")
    for effect in (d.get("lessonEffect") or {}).values():
        flag = "  NOT WORKING" if effect["notWorking"] else ""
        print(f"lesson [{effect['repo']}] {effect['text'][:60]}: sent on {effect['sent']}, "
              f"recurred on {effect['recurred']}{flag}")


def cmd_resolve(resolution, args):
    if len(args) < 2:
        die(f"usage: factory {resolution} <owner/repo#n> <note>")
    who = run("gh", "api", "user", "--jq", ".login").stdout.strip() or os.environ.get("USER", "owner")
    wi = call("factory_resolve_human", {"id": args[0], "resolution": resolution,
                                        "note": " ".join(args[1:]), "by": who})["workItem"]
    print(f"{wi['id']}: {wi['state']}. The factory takes it from here.")


def service_env():
    """The environment factory-mcp runs in: this one, then the settings, then the secrets."""
    return dict(os.environ, **SETTINGS, **read_env(CONFIG / "secrets"))


def relay_token():
    """The token factory-mcp sends the relay (factory_mcp.relay.token), from the same environment.
    Kept here so that `factory stop` works even when factory_mcp does not import. Never printed."""
    env = service_env()
    value = env.get("AGENT_RELAY_TOKEN", "").strip()
    if value:
        return value
    path = env.get("AGENT_RELAY_TOKEN_FILE") or Path.home() / ".config" / "agent-relay" / "token"
    try:
        return Path(path).read_text(encoding="utf-8").strip() or None
    except OSError:
        return None


def relay_json(method, path):
    token = relay_token()
    request = urllib.request.Request(f"{RELAY}{path}", method=method,
                                     headers={"Authorization": f"Bearer {token}"} if token else {})
    with urllib.request.urlopen(request, timeout=10) as response:
        return json.loads(response.read() or b"null")


def listening():
    return run("lsof", f"-tiTCP:{PORT}", "-sTCP:LISTEN").stdout.split()


def cmd_stop(_):
    # 1. Cancel running worker tasks: the relay stops each runner, and the runner kills its container.
    workers = {w.split(":")[0] for w in (SETTINGS.get("FACTORY_WORKERS") or "").split(",") if w}
    try:
        listing = relay_json("GET", "/v1/tasks?status=running")
        tasks = listing.get("tasks", []) if isinstance(listing, dict) else listing
        for task in tasks:
            if task.get("agentId") in workers:
                relay_json("DELETE", f"/v1/tasks/{task['id']}")
                print(f"cancelled worker task {task['id']}")
    except OSError as exc:
        print(f"relay: not reachable ({exc}); no worker task to cancel there")
    # 2. Stop factory-mcp so nothing new is dispatched, and keep launchd from starting it again.
    if run("launchctl", "bootout", f"gui/{os.getuid()}/{LABEL}").returncode == 0:
        print("stopped the factory-mcp service")
    for pid in listening():
        os.kill(int(pid), 15)
        print(f"stopped factory-mcp (pid {pid})")
    # 3. Any sandbox container that is still up.
    left = run("docker", "ps", "-q", "--filter", "label=factory-worker").stdout.split()
    if left:
        run("docker", "kill", *left)
        print(f"killed {len(left)} worker container(s)")
    print("The factory is stopped. Start it again with: factory start")


def up(url):
    try:
        urllib.request.urlopen(url, timeout=3).read()
        return True
    except OSError:
        return False


def cmd_start(_):
    if run("docker", "info").returncode != 0:
        run("orb", "start")
    print("docker:", "up" if run("docker", "info").returncode == 0 else "DOWN (start OrbStack; workers need it)")
    if not up(f"{RELAY}/healthz"):
        run("launchctl", "kickstart", f"gui/{os.getuid()}/{RELAY_LABEL}")
        time.sleep(2)
    print("relay:", "up" if up(f"{RELAY}/healthz") else "DOWN")
    plist = Path.home() / "Library" / "LaunchAgents" / f"{LABEL}.plist"
    if plist.is_file() and run("launchctl", "print", f"gui/{os.getuid()}/{LABEL}").returncode != 0:
        run("launchctl", "bootstrap", f"gui/{os.getuid()}", str(plist))
    for _ in range(40):
        if listening():
            break
        time.sleep(0.5)
    print("factory-mcp:", "up" if listening() else "DOWN (see: factory logs)")


def restart_factory_mcp():
    run("launchctl", "kickstart", "-k", f"gui/{os.getuid()}/{LABEL}")


def branch_merged(branch):
    """True if the branch's PR was merged. A squash merge leaves no ancestry for git to see."""
    done = subprocess.run(["gh", "pr", "list", "--head", branch, "--state", "merged", "--json", "number",
                           "-q", "length"], cwd=HERE, capture_output=True, text=True)
    return done.returncode == 0 and done.stdout.strip() not in ("", "0")


# Commands a repo's verify may call, as on GitHub's runners (#136: `python` was missing).
WORKER_CHECK = "python --version && python3 --version && git --version"


def cmd_update(_):
    """Deploy this checkout's branch: follow a merged branch to the default branch, fast-forward,
    and restart factory-mcp only if the tests pass there. A failing test keeps the old commit. The
    images and Day Desk's profile follow what changed since the last commit they were all built
    for, so a step that failed runs again on the next update."""
    def git(*args):
        return subprocess.run(["git", "-C", str(HERE), *args], capture_output=True, text=True)
    if git("status", "--porcelain", "--untracked-files=no").stdout.strip():
        die(f"update: {HERE} has local changes; update only a deployment checkout")
    old, branch = git("rev-parse", "HEAD").stdout.strip(), git("branch", "--show-current").stdout.strip()
    if git("fetch", "-q", "--prune", "origin").returncode != 0:
        die("update: git fetch failed")
    default = git("symbolic-ref", "--short", "refs/remotes/origin/HEAD").stdout.strip().split("/", 1)[-1] or "main"
    if branch != default and (git("rev-parse", "-q", "--verify", "@{upstream}").returncode != 0
                              or branch_merged(branch)):
        if git("checkout", "-q", default).returncode != 0:
            die(f"update: cannot switch from {branch} to {default}")
    if git("merge", "-q", "--ff-only", "@{upstream}").returncode != 0:
        die("update: the deployment checkout does not fast-forward")
    new = git("rev-parse", "HEAD").stdout.strip()
    deployed_file = STATE / "deployed"
    try:
        since = deployed_file.read_text().strip() or old
    except OSError:  # the first update: what ran before it is deployed, and the record starts there
        since = old
        STATE.mkdir(parents=True, exist_ok=True)
        deployed_file.write_text(old + "\n")
    if new == since:
        return
    tests = subprocess.run([sys.executable, "-m", "unittest", "discover", "-s", "tests", "-p", "test_*.py"],
                           cwd=HERE, capture_output=True, text=True)
    if tests.returncode != 0:
        if new != old:  # on a retry the checkout is already on `new`, and factory-mcp runs it
            git("checkout", "-q", "-f", branch)
            git("reset", "-q", "--hard", old)
        why = "\n".join((tests.stdout + tests.stderr).strip().splitlines()[-20:])
        die(f"update: tests fail at {new[:7]}; factory-mcp stays on {old[:7]}\n{why}")
    def changed(path):  # an unknown `since` fails the diff, and then every step runs
        return git("diff", "--quiet", since, new, "--", path).returncode != 0

    def must(what, *cmd):  # factory-mcp may already run the new code; say what lags behind it
        try:
            done = run(*cmd)
        except FileNotFoundError:
            die(f"update: {what} failed at {new[:7]}: no {cmd[0]} on PATH; the next update tries again")
        if done.returncode != 0:
            die(f"update: {what} failed at {new[:7]}: {' '.join((done.stderr or done.stdout).split())[-300:]}")
        return done.stdout
    if changed("worker/Dockerfile"):  # workers use :latest, so a build that lacks a command repos use never gets it
        must("the worker image build", "docker", "build", "-q", "-t", "factory-worker:candidate", str(HERE / "worker"))
        must("the worker image check", "docker", "run", "--rm", "factory-worker:candidate", "sh", "-c", WORKER_CHECK)
        must("the worker image tag", "docker", "tag", "factory-worker:candidate", "factory-worker:latest")
    if new != old or changed("worker/Dockerfile"):  # a retry restarted already, unless it rebuilds the worker
        restart_factory_mcp()
    if changed("tenant/hermes/sandbox"):
        must("Day Desk's sandbox image build", "docker", "build", "-q", "-t", "day-desk-sandbox:1",
             str(HERE / "tenant" / "hermes" / "sandbox"))
    if changed("tenant/hermes"):  # the profile's config.yaml is kept
        source = re.search(r"^\s*Installed from:\s*(\S+)", must("hermes profile show", "hermes", "profile", "show",
                                                             "day-desk"), re.M)
        want = str(HERE / "tenant" / "hermes")
        if not source or os.path.realpath(source.group(1).strip()) != os.path.realpath(want):
            die(f"update: Day Desk's profile is installed from {source.group(1).strip() if source else 'nowhere'}, "
                f"not {want}, so an update would copy the wrong files. Install it from {want} (RUNBOOK)")
        must("hermes profile update", "hermes", "profile", "update", "day-desk", "-y")
    deployed_file.write_text(new + "\n")
    print(f"update: deployed {new[:7]} (was {since[:7]})")
    if changed("tenant/hermes/config.yaml"):
        print("update: tenant/hermes/config.yaml changed. The live ~/.hermes/profiles/day-desk/config.yaml "
              "keeps your model and Telegram settings, so merge the change into it by hand (RUNBOOK)")


def cmd_serve(_):
    env = service_env()
    env.setdefault("FACTORY_REPOS_FILE", str(CONFIG / "repos.json"))
    env.setdefault("FACTORY_LESSONS_FILE", str(CONFIG / "lessons.json"))
    if not env.get("FACTORY_MCP_TOKEN"):
        die(f"no FACTORY_MCP_TOKEN in {CONFIG / 'secrets'}")
    if not env.get("FACTORY_GITHUB_TOKEN"):
        env["FACTORY_GITHUB_TOKEN"] = run("gh", "auth", "token", check=True).stdout.strip()
    os.chdir(HERE)
    os.execvpe(sys.executable, [sys.executable, "-m", "factory_mcp"], env)


def main(argv):
    command, args = (argv[0], argv[1:]) if argv else ("", [])
    if command == "new":
        cmd_new(args)
    elif command == "add-repo":
        cmd_add_repo(args)
    elif command == "bench":
        cmd_bench(args)
    elif command == "status":
        cmd_status(args)
    elif command == "watch":
        cmd_watch(args)
    elif command == "drive-queue":
        cmd_drive_queue(args)
    elif command == "report":
        cmd_report(args)
    elif command in ("retry", "regate", "close"):
        cmd_resolve(command, args)
    elif command == "stop":
        cmd_stop(args)
    elif command == "start":
        cmd_start(args)
    elif command == "logs":
        os.execvp("tail", ["tail", "-n", "50", "-f", str(STATE / "server.log")])
    elif command == "call" and args:
        print(json.dumps(call(args[0], json.loads(args[1]) if len(args) > 1 else {}), indent=1))
    elif command == "serve":
        cmd_serve(args)
    elif command == "update":
        cmd_update(args)
    else:
        print(__doc__.strip())
        sys.exit(2)


if __name__ == "__main__":
    main(sys.argv[1:])
