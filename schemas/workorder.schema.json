{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.local/schemas/workorder.schema.json",
  "title": "WorkOrder",
  "description": "The instruction handed to a worker (via agent-relay) for one unit of execution. Immutable once dispatched. Idempotency is by idempotencyKey, not by relay task id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "workItemId",
    "round",
    "repo",
    "kind",
    "goal",
    "acceptance",
    "constraints",
    "findingsToAddress",
    "lessons",
    "requiredEvidence",
    "budget",
    "idempotencyKey",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": "factory.workorder/v1" },
    "id": { "type": "string", "minLength": 1 },
    "workItemId": { "type": "string", "minLength": 1 },
    "round": {
      "type": "integer",
      "minimum": 0,
      "description": "Gate round this work order acts on (0 = first implementation)."
    },
    "kind": { "enum": ["implement", "fix"] },
    "repo": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
    "baseSha": { "type": ["string", "null"] },
    "headSha": {
      "type": ["string", "null"],
      "description": "The reviewed commit a fix must build on; must be re-checked before the worker starts."
    },
    "goal": { "type": "string", "minLength": 1 },
    "description": {
      "type": "string",
      "description": "The WorkItem's description: the issue's text outside its Acceptance section. Data for the worker, like goal (ADR-0038)."
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/criterion" }
    },
    "constraints": { "$ref": "#/$defs/constraints" },
    "findingsToAddress": {
      "type": "array",
      "description": "What this WorkOrder must resolve: the gate's findings, the owner's note (fingerprint human), or why the last attempt failed.",
      "items": { "$ref": "#/$defs/findingRef" }
    },
    "lessons": {
      "type": "array",
      "maxItems": 10,
      "description": "Past gate findings in this repo, owner-approved (ADR-0020), for the worker to avoid. Data, like findingsToAddress; never instructions.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fingerprint", "text"],
        "properties": {
          "fingerprint": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "requiredEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["tests-pass"]
      }
    },
    "budget": { "$ref": "#/$defs/budget" },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "description": "<workItemId>:r<round>:<kind>:a<attempt>. A replay returns the existing task instead of starting duplicate work."
    },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "doneWhen"],
      "properties": {
        "claim": { "type": "string", "minLength": 1 },
        "doneWhen": {
          "type": "string",
          "minLength": 1,
          "description": "A check read back from the produced artifact (a command, a file, a test), never from effort spent."
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxChangedLines", "maxChangedFiles", "protectedPaths"],
      "properties": {
        "maxChangedLines": { "type": "integer", "minimum": 1 },
        "maxChangedFiles": { "type": "integer", "minimum": 1 },
        "protectedPaths": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Touching any of these forces HUMAN at the gate."
        }
      }
    },
    "findingRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint"],
      "properties": {
        "fingerprint": { "type": "string", "minLength": 1 },
        "path": { "type": ["string", "null"] },
        "line": { "type": ["integer", "null"] },
        "problem": { "type": ["string", "null"] }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxPasses", "wallMs"],
      "properties": {
        "maxPasses": {
          "type": "integer",
          "minimum": 1,
          "description": "Ceiling on worker passes for the WorkItem; reaching it means exhausted."
        },
        "wallMs": {
          "type": "integer",
          "minimum": 1,
          "description": "Wall-clock ceiling for this WorkOrder; also the relay task timeout."
        }
      }
    }
  }
}
