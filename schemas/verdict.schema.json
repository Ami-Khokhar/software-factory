{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.local/schemas/verdict.schema.json",
  "title": "Verdict",
  "description": "pr-gatekeeper's decision on one PR head, normalized from the marker JSON in its PR comment (factory_mcp/verdict.py). The Foreman acts on this document, never on the comment's prose.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repo",
    "prNumber",
    "round",
    "headSha",
    "outcome",
    "findings",
    "publishedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "factory.verdict/v1" },
    "repo": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
    "prNumber": { "type": "integer", "minimum": 1 },
    "round": { "type": "integer", "minimum": 0 },
    "headSha": {
      "type": "string",
      "minLength": 1,
      "description": "The commit this verdict applies to. The controller must reject a verdict whose headSha is not the current WorkItem headSha."
    },
    "outcome": { "enum": ["MERGE", "CHANGES", "HUMAN"] },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "publishedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint", "severity", "problem"],
      "properties": {
        "fingerprint": {
          "type": "string",
          "minLength": 1,
          "description": "Stable identity of the problem, used for same-problem round counting."
        },
        "severity": { "enum": ["blocking", "minor"] },
        "path": { "type": ["string", "null"] },
        "line": { "type": ["integer", "null"] },
        "problem": { "type": "string", "minLength": 1 },
        "fix": { "type": ["string", "null"] }
      }
    }
  }
}
