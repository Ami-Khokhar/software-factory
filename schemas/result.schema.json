{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.local/schemas/result.schema.json",
  "title": "Result",
  "description": "A worker's handoff: a patch, which factory-mcp pushes (ADR-0017), plus evidence. It is the last JSON line of the relay task's output; the Foreman reads nothing else the worker prints. This is what makes the factory harness-agnostic: any harness that can commit is a valid worker.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workOrderId", "status", "startedAt", "finishedAt"],
  "properties": {
    "schemaVersion": { "const": "factory.result/v1" },
    "workOrderId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["completed", "failed"] },
    "patch": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "diff"],
          "properties": {
            "format": {
              "enum": ["unified", "mbox"],
              "description": "unified = git diff output; mbox = git format-patch output."
            },
            "baseSha": { "type": ["string", "null"], "description": "Commit the diff applies to." },
            "diff": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "error": { "type": ["string", "null"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
      "then": { "required": ["patch"], "properties": { "patch": { "type": "object" } } }
    },
    {
      "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
      "then": { "required": ["error"], "properties": { "error": { "type": "string", "minLength": 1 } } }
    }
  ],
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "command", "exit"],
      "properties": {
        "kind": { "enum": ["test"] },
        "command": { "type": "string", "minLength": 1 },
        "exit": { "type": "integer" },
        "tail": { "type": ["string", "null"] }
      }
    }
  }
}
